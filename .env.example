# 실제 값은 ~/.ttakkari/config.env 에 둔다(`ttakkari init-config` 로 생성). 모든 키는 TTAKKARI_ 접두사.
TTAKKARI_ENV=dev                      # dev | prod. prod 에서는 JWT_SECRET 이 필수
TTAKKARI_DATABASE_URL=postgresql+asyncpg://localhost/ttakkari
TTAKKARI_HOME=~/.ttakkari             # 데이터(artifacts, outbox, guard.log)가 놓이는 디렉터리
TTAKKARI_JWT_SECRET=                  # python -c "import secrets;print(secrets.token_urlsafe(48))"
TTAKKARI_ACCESS_TOKEN_TTL_SECONDS=900
TTAKKARI_REFRESH_TOKEN_TTL_DAYS=30
TTAKKARI_DOWNLOAD_TOKEN_TTL_SECONDS=300
TTAKKARI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]  # JSON 배열
# Cloudflare Tunnel 뒤에서만 지정(예: CF-Connecting-IP). 직접 노출 시 위조 가능
# TTAKKARI_TRUST_PROXY_IP_HEADER=CF-Connecting-IP
# 워크스페이스로 등록 가능한 상위 경로(JSON 배열). 이 밖은 등록 거부
TTAKKARI_ALLOWED_ROOTS=["/Users/you/development","/Users/you/Documents"]
TTAKKARI_CLAUDE_BIN=claude
TTAKKARI_CODEX_BIN=codex
# 전역 hook 이 headless 실행에 끼어드는 것을 좁힐 때
# TTAKKARI_CLAUDE_SETTING_SOURCES=project,local
TTAKKARI_MAX_CONCURRENT_DESK=16
TTAKKARI_MAX_CONCURRENT_LEADS=16
TTAKKARI_MAX_CONCURRENT_WORKERS=16
TTAKKARI_RUN_TIMEOUT_SECONDS=7200
TTAKKARI_CANCEL_GRACE_SECONDS=5.0
# ADR 0066 worker worktree isolation + verified serial delivery (default off)
TTAKKARI_DELIVERY_PIPELINE_ENABLED=false
TTAKKARI_COPY_MAX_BYTES=209715200     # 200MiB
TTAKKARI_ARTIFACT_RETENTION_DAYS=90
# 문서 미리보기용 LibreOffice 경로(없으면 미리보기 생략)
# TTAKKARI_SOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
TTAKKARI_LOGIN_MAX_FAILURES=5
TTAKKARI_LOGIN_LOCK_SECONDS=900

# 회의 전사: 로컬 우선. Python/가중치는 사전 설치하며 요청 때 다운로드하지 않는다.
TTAKKARI_MEETING_DEFAULT_PROVIDER=local_whisper
TTAKKARI_LOCAL_STT_ENABLED=true
# TTAKKARI_LOCAL_STT_PYTHON=/absolute/stt-venv/bin/python
# TTAKKARI_LOCAL_STT_MODEL_PATH=/absolute/local-large-v3-snapshot

# Omit this key to use the owner-only Qwen switch in Settings (default off).
# Explicit true/false pins operator policy and locks the app switch.
# Enabling still requires doctor to attest Seatbelt, host monitoring and fixture.
# TTAKKARI_QWEN_LOCAL_ENABLED=false
# TTAKKARI_QWEN_LOCAL_TURNS=20
# TTAKKARI_QWEN_LOCAL_WORKER_PATH=/absolute/path/to/qwen-local-harness/bin/qwen-worker
TTAKKARI_CLOVANOTE_ENABLED=false
TTAKKARI_CLOVANOTE_POLL_SECONDS=0
TTAKKARI_RESOURCE_SAMPLE_SECONDS=30
# 검색용 E5도 요청별 프로세스에서만 로드한다.
TTAKKARI_CONTEXT_EMBEDDING_CPU_THREADS=2
TTAKKARI_CONTEXT_EMBEDDING_TIMEOUT_SECONDS=300

# Separate Flash Next server monitoring (GET props/metrics only; never starts a model).
TTAKKARI_QWEN_FLASH_MONITOR_PORT=18987
TTAKKARI_QWEN_FLASH_MONITOR_MODEL=qwen-flash-next-q2k

# Muse Code: explicit opt-in after real model, guard, resume and operating-runtime verification.
TTAKKARI_MUSE_ENABLED=false
# TTAKKARI_MUSE_BIN=/absolute/path/to/muse
# TTAKKARI_MUSE_NODE_BIN=node
# TTAKKARI_MUSE_RUNTIME_ROOT=/absolute/backend/.muse-runtime
# TTAKKARI_MUSE_PROFILE_ROOT=/absolute/profile-root
# The profile root holds config/muse/settings.json, data/muse and cache/muse via official XDG variables.
