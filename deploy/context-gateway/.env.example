# Generate these as URL-safe random strings and copy to a non-repository .env.
CONTEXT_GATEWAY_DB_ADMIN_PASSWORD=replace-with-random-admin-password
CONTEXT_GATEWAY_DB_PUBLIC_PASSWORD=replace-with-random-public-password
CONTEXT_GATEWAY_CONTROL_TOKEN=replace-with-independent-256-bit-control-token

# Host loopback ports: public is separate from Ttakkari Caddy (:8787).
CONTEXT_GATEWAY_PUBLIC_PORT=8796
CONTEXT_GATEWAY_CONTROL_PORT=8788

# Include every Host header used to reach the public MCP endpoint.
CONTEXT_GATEWAY_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,localhost:*,127.0.0.1:*
